{
  "name": "coupon-issue-sim",
  "version": "0.1.0",
  "private": true,
  "description": "쿠폰 발급 시뮬레이션 — 동시성 제어 학습용 풀스택 프로젝트 (Express + Prisma + React)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/server && npm run build --workspace apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/server",
    "prisma:generate": "npm run prisma:generate --workspace apps/server",
    "seed": "npm run seed --workspace apps/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
