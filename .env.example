# --- Server ---
# Postgres (docker-compose 기본값과 일치)
DATABASE_URL="postgresql://coupon:coupon@localhost:5432/coupon?schema=public"
# Redis
REDIS_URL="redis://localhost:6379"
# API 서버 포트
PORT=4000
# JWT 시크릿 (Stage 5에서 사용) — 실제로는 긴 랜덤 문자열로 교체
JWT_SECRET="dev-only-change-me"

# --- Web ---
# 프론트에서 호출할 API 베이스 URL (Vite: VITE_ 접두사 필수)
VITE_API_URL="http://localhost:4000"
